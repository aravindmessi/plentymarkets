{
  "login": {
    "schema": {
      "protocol": "https",
      "method": "POST",
      "host": "<%= iparam.SWdomain %>",
      "path": "/rest/login",
      "headers": {
        "Content-Type": "application/json"
      }
    }
  },
  "validateCredentials": {
    "schema": {
      "method": "POST",
      "protocol": "https",
      "host": "<%= context.domain %>",
      "path": "/rest/login",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "options": {}
  },
  "getWorkitem": {
    "schema": {
      "method": "GET",
      "protocol": "https",
      "host": "<%= iparam.SWdomain %>",
      "path": "/rest/orders",
      "headers": {
        "Authorization": "<%= context.token %>",
        "Content-Type": "application/json"
      },
      "query": {
        "with[]": [
          "addresses",
          "payments",
          "shippingPackages",
          "relations",
          "warehouseSender",
          "orderItems.variation",
          "documents"
        ],
        "itemsPerPage": "10",
        "contactData": "<%= context.senderEmail %>"
      }
    },
    "options": {}
  },
  "getOrderNumberItems": {
    "schema": {
      "method": "GET",
      "protocol": "https",
      "host": "<%= iparam.SWdomain %>",
      "path": "/rest/orders",
      "headers": {
        "Authorization": "<%= context.token %>",
        "Content-Type": "application/json"
      },
      "query": {
        "with[]": [
          "addresses",
          "shippingInformation",
          "payments",
          "shippingPackages",
          "relations",
          "warehouseSender",
          "orderItems.variation",
          "documents",
          "location",
          "originOrderReferences"
        ],
        "orderIds": "<%= context.orderID %>"
      }
    },
    "options": {}
  },
  "getContactAddress": {
  "schema": {
    "method": "GET",
    "protocol": "https",
    "host": "<%= iparam.SWdomain %>",
    "path": "/rest/accounts/contacts/<%= context.contactID %>/addresses/<%= context.addressID %>",
    "headers": {
      "Authorization": "<%= context.token %>",
      "Content-Type": "application/json"
    }
  },
  "options": {}
}
}
